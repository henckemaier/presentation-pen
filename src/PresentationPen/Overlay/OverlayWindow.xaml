<Window x:Class="PresentationPen.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresentationPen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="800" Height="600">
    <!--
      Transparência feita pelo DWM (ver EnableDwmTransparency), não por janela em camadas (AllowsTransparency):
      a janela em camadas copia a tela inteira da GPU para a CPU a cada quadro, o que deixava o zoom pesado.
      Uma janela comum recebe os cliques em toda a área, mesmo onde está transparente.
    -->
    <Grid x:Name="RootGrid" ClipToBounds="True" Background="Transparent">
        <Rectangle x:Name="BoardRect" Fill="White" Visibility="Collapsed" />

        <Grid x:Name="ContentRoot">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ZoomTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- imagem da tela salva junto com um rascunho (para continuar sobre ela) -->
            <!-- Linear: interpolação simples feita pela GPU; HighQuality recalcula mipmaps e pesa no zoom -->
            <Image x:Name="DraftBackground" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="Linear" />
            <Image x:Name="SnapshotImage" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="Linear" />
            <Canvas x:Name="ShapeCanvas" Background="Transparent" />
            <InkCanvas x:Name="Ink" Background="Transparent" />
        </Grid>
    </Grid>
</Window>

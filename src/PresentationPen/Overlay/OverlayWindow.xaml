<Window x:Class="PresentationPen.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PresentationPen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0" Width="800" Height="600">
    <!-- Fundo com alfa 1: invisível, mas captura os cliques (pixels com alfa 0 deixam o clique passar). -->
    <Grid x:Name="RootGrid" ClipToBounds="True">
        <Rectangle x:Name="BoardRect" Fill="White" Visibility="Collapsed" />

        <Grid x:Name="ContentRoot">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ZoomTranslate" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- imagem da tela salva junto com um rascunho (para continuar sobre ela) -->
            <Image x:Name="DraftBackground" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Image x:Name="SnapshotImage" Stretch="Fill" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Canvas x:Name="ShapeCanvas" Background="Transparent" />
            <InkCanvas x:Name="Ink" Background="Transparent" />
        </Grid>
    </Grid>
</Window>

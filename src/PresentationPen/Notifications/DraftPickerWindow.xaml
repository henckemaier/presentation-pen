<Window x:Class="PresentationPen.Notifications.DraftPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abrir rascunho - PresentationPen"
        Width="780" Height="540" MinWidth="460" MinHeight="320"
        Background="#FF202124"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="5" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#45FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Rascunhos salvos" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10" />

        <ListBox x:Name="DraftList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="RenameMenuItem" Header="Renomear" InputGestureText="F2" />
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame" Margin="5" Padding="8" CornerRadius="8"
                                        Background="#1AFFFFFF" BorderBrush="Transparent" BorderThickness="2">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Frame" Property="Background" Value="#2AFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Frame" Property="BorderBrush" Value="#FF3D7EFF" />
                                        <Setter TargetName="Frame" Property="Background" Value="#303D7EFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="210">
                        <Border Height="118" CornerRadius="5" Background="#40000000">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Grid Margin="0,6,0,0">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Hidden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="13"
                                     Background="#FF2D2E31" Foreground="White" CaretBrush="White"
                                     BorderBrush="#FF3D7EFF" Padding="2,0" Margin="-3,-2"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                     IsVisibleChanged="RenameBox_IsVisibleChanged"
                                     PreviewKeyDown="RenameBox_PreviewKeyDown"
                                     LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                        </Grid>
                        <TextBlock Text="{Binding Modified, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="#90FFFFFF"
                                   FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyText" Grid.Row="1" Foreground="#A0FFFFFF" FontSize="14" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Text="Nenhum rascunho salvo ainda.&#x0a;No modo desenho, use Ctrl+S para salvar." Visibility="Collapsed" />

        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#FFFFB300" FontSize="12" Margin="4,8,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox x:Name="UseBackgroundCheck" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Foreground="White" Content="Mostrar a imagem da tela salva por trás dos desenhos"
                      ToolTip="Depois de abrir, dá para alternar com a tecla B ou o botão de imagem na barra" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Abrir" IsDefault="True" Background="#FF3D7EFF" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancelar" IsCancel="True" />
            <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Abrir pasta" />
            <Button x:Name="RenameButton" DockPanel.Dock="Right" Content="Renomear" ToolTip="Renomear (F2)" />
        </DockPanel>
    </Grid>
</Window>
